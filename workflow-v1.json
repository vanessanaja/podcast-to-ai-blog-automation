      ],
      "id": "15fb8579-a5dc-46af-a56c-32604b8e6d65",
      "name": "Edit Fields"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-6-luna",
          "mode": "id"
        },
        "responses": {
          "values": [
            {
              "content": "=Transform the podcast transcript below into a publication-ready blog content package.\n\nReturn exactly these fields:\n\n- blog_title\n- meta_title\n- meta_description\n- html\n- faq_schema\n\nRequirements:\n\n- blog_title: Clear, compelling title for the article.\n- meta_title: SEO-friendly title suitable for search results.\n- meta_description: Concise search description.\n- html: The complete blog post as clean HTML. Do not wrap it in Markdown code fences.\n- faq_schema: Valid FAQPage JSON-LD as a string. Do not wrap it in Markdown code fences.\n\nUse only information supported by the transcript.\nDo not invent facts, statistics, quotes, claims, URLs, products, or resources.\n\nRelevant resources:\n\n{{$json.relevant_links}}\n\nWhen one or more of these resources are genuinely relevant to the article, include them naturally within the HTML using descriptive anchor text.\n\nDo not force a resource into the article if it is not relevant.\nUse only URLs provided in the Relevant resources section above.\n\nPodcast transcript:\n\n{{$json.transcript}}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "name": "podcast_blog_output",
              "schema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"blog_title\": {\n      \"type\": \"string\"\n    },\n    \"meta_title\": {\n      \"type\": \"string\"\n    },\n    \"meta_description\": {\n      \"type\": \"string\"\n    },\n    \"html\": {\n      \"type\": \"string\"\n    },\n    \"faq_schema\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"blog_title\",\n    \"meta_title\",\n    \"meta_description\",\n    \"html\",\n    \"faq_schema\"\n  ]\n}",
              "strict": true
            }
          }
        }
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        896,
        0
      ],
      "id": "6faab408-b26d-4d8a-9cea-0d15eefc46dd",
      "name": "Message a model"
    },
    {
      "parameters": {
        "jsCode": "const openAIResult = $input.first().json;\n\n// Structured content returned by OpenAI\nconst content = openAIResult.output[0].content[0].text;\n\n// Original YouTube URL from the Edit Fields node\nconst youtubeUrl = $('Edit Fields').first().json.youtube_url;\n\n// Extract the YouTube video ID\nlet videoId = '';\n\nif (youtubeUrl.includes('watch?v=')) {\n  videoId = youtubeUrl.split('watch?v=')[1].split('&')[0];\n} else if (youtubeUrl.includes('youtu.be/')) {\n  videoId = youtubeUrl.split('youtu.be/')[1].split('?')[0];\n}\n\n// Build the embed HTML\nconst youtubeEmbed = videoId\n  ? `<div class=\"youtube-embed\">\n      <iframe\n        width=\"560\"\n        height=\"315\"\n        src=\"https://www.youtube.com/embed/${videoId}\"\n        title=\"YouTube video player\"\n        frameborder=\"0\"\n        allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\"\n        allowfullscreen>\n      </iframe>\n    </div>`\n  : '';\n\n// Add the embed to the beginning of the blog HTML\nconst finalHtml = youtubeEmbed + content.html;\n\nreturn [\n  {\n    json: {\n      blog_title: content.blog_title,\n      meta_title: content.meta_title,\n      meta_description: content.meta_description,\n      html: finalHtml,\n      faq_schema: content.faq_schema,\n      youtube_url: youtubeUrl\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1264,
        0
      ],
      "id": "94310d98-386a-4ddc-bb6a-758b4fa74582",
      "name": "Code in JavaScript"
    },
