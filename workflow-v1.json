              "text": "={{ `BLOG TITLE\n\n${$('Code in JavaScript').first().json.blog_title}\n\n\nMETA TITLE\n\n${$('Code in JavaScript').first().json.meta_title}\n\n\nMETA DESCRIPTION\n\n${$('Code in JavaScript').first().json.meta_description}\n\n\nARTICLE HTML\n\n${$('Code in JavaScript').first().json.html}\n\n\nFAQ SCHEMA\n\n${$('Code in JavaScript').first().json.faq_schema}\n\n\nYOUTUBE URL\n\n${$('Code in JavaScript').first().json.youtube_url}` }}"
            }
          ]
        }
